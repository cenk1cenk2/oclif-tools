{
  "name": "@cenk1cenk2/oclif-common",
  "version": "1.0.0",
  "description": "Oclif common package for oclif2 projects.",
  "repository": "https://gitlab.kilic.dev/libraries/oclif-tools",
  "type": "module",
  "author": {
    "name": "Cenk Kilic",
    "email": "cenk@kilic.dev",
    "url": "https://srcs.kilic.dev"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "oclif": {
    "hooks": {
      "command_not_found": "./dist/hooks/not-found.hook.mjs"
    }
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "build": "tsdown",
    "dev:start": "tsdown --watch",
    "format": "prettier --write src/ test/ --log-level warn && eslint --fix src/ test/",
    "lint": "eslint src/ test/",
    "test": "vitest run",
    "docs:api": "typedoc --options .typedoc.json --hideInPageTOC --hideBreadcrumbs"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "es-toolkit": "^1.52.0",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@listr2/manager": "^4.3.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@oclif/core": "^5.1.2",
    "@types/node": "^24.19.1",
    "listr2": "^11.2.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@listr2/manager": ">= 1",
    "@nestjs/common": ">= 12",
    "@nestjs/core": ">= 12",
    "@oclif/core": ">= 1",
    "listr2": ">= 7",
    "yaml": ">= 2"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  }
}
