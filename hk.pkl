amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Monorepo: the old setup had no root lint-staged config and carried identical
// per-package blocks in `packages/common` and `example`. They are declared here
// once, at the root, so every workspace is covered by the same rules.
hooks {
  ["pre-commit"] {
    fix = true
    steps {
      ["prettier"] = (Builtins.prettier) {
        glob = List("*.ts", "*.js", "*.tsx", "*.jsx", "*.json", "*.md")
      }
      ["eslint"] = (Builtins.eslint) {
        glob = List("*.ts", "*.js", "*.tsx", "*.jsx")
        depends = List("prettier")
      }
    }
  }
  ["prepare-commit-msg"] {
    steps {
      ["commitizen"] {
        fix = "git cz --hook"
        interactive = true
      }
    }
  }
}
