{
  "name": "root",
  "private": true,
  "repository": "https://gitlab.kilic.dev/libraries/oclif-tools",
  "type": "module",
  "scripts": {
    "clean": "rimraf node_modules pnpm-lock.yaml",
    "build": "pnpm run -r build",
    "format": "pnpm run --parallel -r format",
    "lint": "pnpm run --parallel -r lint"
  },
  "workspaces": [
    "packages/*",
    "example"
  ],
  "devDependencies": {
    "@cenk1cenk2/cz-cc": "^3.0.1",
    "@cenk1cenk2/eslint-config": "^3.3.6",
    "@tsconfig/node24": "^24.0.5",
    "commitizen": "^4.3.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^7.0.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@cenk1cenk2/cz-cc"
    }
  }
}
