amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Builtins.pkl"

hooks {
  ["pre-commit"] {
    steps {
      // check_first off: hk 2.0.1 reads prettier's --list-different output as repo-relative while this step runs in a subdirectory.
      ["prettier"] = (Builtins.prettier) {
        glob = List("**/*.ts", "**/*.js", "**/*.json", "**/*.md")
        check_first = false
      }
      ["eslint"] = (Builtins.eslint) {
        glob = List("**/*.ts", "**/*.js")
        depends = List("prettier")
      }
    }
  }
}
